# Local environment files. Commit sanitized *.example files only.
.env
.env.*
!.env.example
!.env.*.example
*.env
!*.env.example

# Generated local TLS material and private keys
/traefik_portainer/certs/*
!/traefik_portainer/certs/.gitkeep
/traefik/certs/*
!/traefik/certs/.gitignore
/certs/*
*.key
*.key.pem
*.pem
*.p12
*.pfx
*.jks
*.keystore
.envrc
.secrets/
**/.secrets/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Kubernetes Secret manifests containing values; use a secret manager or CLI
*-secret.yaml
*-secret.yml
!*-secret.example.yaml
!*-secret.example.yml

# Local backups can contain credentials copied from real manifests
*.bak
*.backup
*.orig
